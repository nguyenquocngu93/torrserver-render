<addon id="skin.arctic.fuse.2.touch" name="Arctic Fuse 2 Touch" provider-name="jurialmunkey + Touch Mod" version="2.12.12-touch">
    <requires>
        <import addon="xbmc.gui" version="5.17.0" />
        <import addon="script.skinvariables" version="2.1.28" />
        <import addon="script.texturemaker" version="0.2.9" />
        <import addon="plugin.video.themoviedb.helper" version="6.12.1" />
        <import addon="resource.images.weathericons.white" version="0.0.1" />
        <import addon="resource.images.studios.coloured" version="0.0.1" />
        <import addon="resource.font.robotocjksc" version="0.0.3" />
    </requires>
    <extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
        <res aspect="16:9" default="true" folder="1080i" width="1920" height="1080" />
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Arctic Fuse 2 optimized for touchscreen</summary>
        <description lang="en">Arctic Fuse 2 Touch Mod - Enlarged touch targets (140px), touch-friendly navigation, mouse/touch enabled by default. Perfect for Android tablets and touchscreen devices.</description>
        <platform>all</platform>
        <license>Creative Commons Attribution Non-Commercial Share-Alike 4.0</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
